# Perceptronium Environment Configuration Template
# Copy this file to '.env' and fill in your details to run the GCP training migration pipeline.

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_BUCKET_NAME="your-gcs-bucket-name"
GCP_GCS_PREFIX="perceptronium"
GCP_INSTANCE_NAME="perceptronium-training-l4"
GCP_MACHINE_TYPE="g2-standard-4"
GCP_IMAGE_PROJECT="deeplearning-platform-release"

# Local Dataset Configuration
# Path to the directory where the high-quality extra dataset is downloaded locally.
LOCAL_CATS_DOGS_DATASET_DIR="/path/to/your/cats_dogs_dataset"
